{
  "name": "crystal-ball-command-centre",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "next dev",
    "build": "next build",
    "start": "concurrently -k -n api,web -c cyan,magenta \"npm run start:api\" \"npm run start:web\"",
    "start:api": "tsx src/server/index.ts",
    "start:web": "next start",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:integration && npm run test:components",
    "test:unit": "jest --config jest.config.cjs tests/unit",
    "test:integration": "jest --config jest.config.cjs tests/integration",
    "test:components": "vitest run --config vitest.config.mts",
    "test:watch": "jest --config jest.config.cjs --watch"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "next": "15.5.26",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.26",
    "jest": "^30.5.2",
    "jsdom": "^29.1.1",
    "supertest": "^7.3.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
